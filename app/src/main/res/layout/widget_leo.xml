<?xml version="1.0" encoding="utf-8"?>
<!-- [ mic / stop ]  Leo · status            [ switch «Привіт, Leo» ] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/widget_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_button_idle"
        android:contentDescription="@string/widget_label"
        android:padding="13dp"
        android:src="@drawable/ic_widget_mic"
        android:tint="@color/lion_crimson_dark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant_sc_bold"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textColor="@color/lion_gold_light"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_status_idle"
            android:textColor="#CCF3D58A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_wake"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">

        <ImageView
            android:id="@+id/widget_wake_switch"
            android:layout_width="44dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_wake"
            android:src="@drawable/widget_switch_off" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/widget_wake"
            android:textColor="#CCF3D58A"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
