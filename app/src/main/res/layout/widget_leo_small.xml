<?xml version="1.0" encoding="utf-8"?>
<!-- One cell wide: only the start/stop button (the switch needs the wide layout) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_button_idle"
        android:contentDescription="@string/widget_label"
        android:padding="14dp"
        android:src="@drawable/ic_widget_mic"
        android:tint="@color/lion_crimson_dark" />
</FrameLayout>
